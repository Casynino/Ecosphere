# Copy this file to .env.local for local development.
# On Vercel, add the same names under Project > Settings > Environment Variables.
# Never commit real keys.

# Public address of the site, without a trailing slash. Used for canonical
# links, the sitemap and social share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact form (Resend: https://resend.com) ---
# API key from the Resend dashboard.
RESEND_API_KEY=
# Inbox that receives consultation requests.
CONTACT_TO_EMAIL=intecosphere.solutions@gmail.com
# Sender shown on those emails. Until a domain is verified in Resend, keep the
# test sender below (it only delivers to the Resend account owner's address).
CONTACT_FROM_EMAIL="Ecosphere Solutions website <onboarding@resend.dev>"

# Email address shown on the site. Change it when the domain email is ready.
NEXT_PUBLIC_CONTACT_EMAIL=intecosphere.solutions@gmail.com

# --- Analytics (both options are cookie-free, so no consent banner) ---
# "vercel" (also enable Web Analytics in the Vercel dashboard), "plausible", or leave empty for none.
NEXT_PUBLIC_ANALYTICS_PROVIDER=
# Only for Plausible: the site's domain as registered there.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
